# Copy to .env and replace the API key before starting the server.
VLLM_API_KEY=replace-with-a-long-random-key
# Paths are relative to this repository root when using --project-directory.
# Point MODEL_DIR at one complete checkpoint, not its parent directory.
MODEL_DIR=./models/Qwen3.8-Flash-Next-W4A16-Attn8-FP8PLE
CHAT_TEMPLATE=./templates/qwen38-sharp-v22.4.0.jinja
VLLM_IMAGE=local/qwen38-flash-next:e962733e-ampere-pp
SERVED_MODEL_NAME=qwen38-flash-next
HOST_IP=127.0.0.1
HOST_PORT=8000
GPU_MEMORY_UTILIZATION=0.94
# These settings permit NCCL P2P; they do not enable P2P in the driver.
NCCL_P2P_DISABLE=0
NCCL_P2P_LEVEL=SYS
