+            (
+                input_ids.shape[0],
+                embedding.ngram_heads * quant_method.packed_row_width,
+            ),
+            device=hidden_states.device,
+            dtype=torch.uint8,
+        )
+    return torch.empty(
+        (input_ids.shape[0], embedding.embedding_dim),
+        device=hidden_states.device,
